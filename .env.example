# ============================================================
#  MIRAJ Recouvrement — Variables d'environnement
# ============================================================

# Environnement d'exécution ('development' ou 'production')
# En production, active les vérifications strictes de sécurité (CSP HSTS, secrets, CORS)
NODE_ENV=production

# Port d'écoute du serveur Express (défaut : 3000)
PORT=3000

# Clé secrète JWT pour la signature des tokens admin (OBLIGATOIRE en prod, min. 32 caractères)
# Générer par exemple avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=votre_cle_secrete_tres_longue_et_aleatoire_min_32_caracteres_miraj

# Identifiant administrateur initial (défaut : admin)
ADMIN_USERNAME=admin

# Mot de passe administrateur initial (OBLIGATOIRE en prod, min. 10 caractères avec maj/min/chiffre)
ADMIN_PASSWORD=MirajRecouv2026!Securise

# Origines autorisées pour les requêtes CORS (séparées par une virgule en production)
ALLOWED_ORIGINS=https://miraj-recouv.com,https://www.miraj-recouv.com
